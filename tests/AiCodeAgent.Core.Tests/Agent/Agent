        var orchestrator = CreateOrchestrator();
        var tool = Substitute.For<ITool>();
        tool.Name.Returns("boom");
        tool.ExecuteAsync(Arg.Any<ToolCall>(), Arg.Any<AgentExecutionContext>())
            .Throws(new InvalidOperationException("kaboom"));
        _toolRegistry.GetTools(Arg.Any<List<string>>()).Returns(new List<ITool> { tool });
        _toolRegistry.GetTool("boom").Returns(tool);
        _contextManager.GetContextAsync(Arg.Any<string>())
            .Returns(new List<Message>());

        var callCount = 0;
        _provider.StreamAsync(Arg.Any<CompletionRequest>(), Arg.Any<CancellationToken>())
            .Returns(_ =>
            {
                callCount++;
                if (callCount == 1)
                {
                    return new[]
                    {
                        new StreamChunk
                        {
                            IsFinished = true,
                            FinishReason = "tool_calls",
                            ToolCalls = new List<ToolCall>
                            {
                                new() { Id = "tc1", Name = "boom" }
                            }
                        }
                    }.ToAsyncEnumerable();
                }
                return new[]
                {
                    new StreamChunk { Delta = "ok", IsFinished = true, FinishReason = "stop" }
                }.ToAsyncEnumerable();
            });

        var response = await orchestrator.RunAsync("call boom", "session1", DefaultOptions());

        Assert.True(response.ToolExecutions[0].Result.IsError);
        Assert.Contains("kaboom", response.ToolExecutions[0].Result.Content);
    }

    [Fact]
    public async Task RunAsync_StopsAfterMaxIterations()
    {
        var orchestrator = CreateOrchestrator();
        var tool = Substitute.For<ITool>();
        tool.Name.Returns("loop_tool");
        tool.ExecuteAsync(Arg.Any<ToolCall>(), Arg.Any<AgentExecutionContext>())
            .Returns(new ToolResult { ToolName = "loop_tool", Content = "x" });
        _toolRegistry.GetTools(Arg.Any<List<string>>()).Returns(new List<ITool> { tool });
        _toolRegistry.GetTool("loop_tool").Returns(tool);
        _contextManager.GetContextAsync(Arg.Any<string>())
            .Returns(new List<Message>());

        // Provider always returns a tool call - never finishes with text.
        _provider.StreamAsync(Arg.Any<CompletionRequest>(), Arg.Any<CancellationToken>())
            .Returns(_ => new[]
            {
                new StreamChunk
                {
                    IsFinished = true,
                    FinishReason = "tool_calls",
                    ToolCalls = new List<ToolCall>
                    {
                        new() { Id = "tc1", Name = "loop_tool" }
                    }
                }
            }.ToAsyncEnumerable());

        var options = DefaultOptions() with { MaxIterations = 2 };
        var response = await orchestrator.RunAsync("loop", "session1", options);

        Assert.Equal(2, response.ToolExecutions.Count);
    }

    [Fact]
    public async Task RunAsync_ReportsCancelled_WhenTokenCancelled()
    {
        var orchestrator = CreateOrchestrator();
        _toolRegistry.GetTools(Arg.Any<List<string>>()).Returns(new List<ITool>());
        _contextManager.GetContextAsync(Arg.Any<string>())
            .Returns(new List<Message>());
        _provider.StreamAsync(Arg.Any<CompletionRequest>(), Arg.Any<CancellationToken>())
            .Returns(_ => new[]
            {
                new StreamChunk { Delta = "partial" }
            }.ToAsyncEnumerable());

        using var cts = new CancellationTokenSource();
        cts.Cancel();

        var response = await orchestrator.RunAsync("hi", "session1", DefaultOptions(), cts.Token);

        Assert.True(response.WasCancelled);
    }

    [Fact]
    public async Task StreamRunAsync_YieldsTextDeltaEvents()
    {
        var orchestrator = CreateOrchestrator();
        _toolRegistry.GetTools(Arg.Any<List<string>>()).Returns(new List<ITool>());
        _contextManager.GetContextAsync(Arg.Any<string>())
            .Returns(new List<Message>());
        _provider.StreamAsync(Arg.Any<CompletionRequest>(), Arg.Any<CancellationToken>())
            .Returns(new[]
            {
                new StreamChunk { Delta = "A" },
                new StreamChunk { Delta = "B", IsFinished = true, FinishReason = "stop" }
            }.ToAsyncEnumerable());

        var events = await CollectEvents(orchestrator.StreamRunAsync("hi", "s", DefaultOptions()));

        Assert.Contains(events, e => e is TextDeltaEvent td && td.Delta == "A");
        Assert.Contains(events, e => e is TextDeltaEvent td && td.Delta == "B");
        Assert.Contains(events, e => e is AgentFinishedEvent);
    }

    [Fact]
    public async Task StreamRunAsync_YieldsToolCallStartAndEndEvents()
    {
        var orchestrator = CreateOrchestrator();
        var tool = Substitute.For<ITool>();
        tool.Name.Returns("read_file");
        tool.ExecuteAsync(Arg.Any<ToolCall>(), Arg.Any<AgentExecutionContext>())
            .Returns(new ToolResult { ToolName = "read_file", Content = "ok" });
        _toolRegistry.GetTools(Arg.Any<List<string>>()).Returns(new List<ITool> { tool });
        _toolRegistry.GetTool("read_file").Returns(tool);
        _contextManager.GetContextAsync(Arg.Any<string>())
            .Returns(new List<Message>());

        var callCount = 0;
        _provider.StreamAsync(Arg.Any<CompletionRequest>(), Arg.Any<CancellationToken>())
            .Returns(_ =>
            {
                callCount++;
                if (callCount == 1)
                {
                    return new[]
                    {
                        new StreamChunk
                        {
                            IsFinished = true,
                            FinishReason = "tool_calls",
                            ToolCalls = new List<ToolCall>
                            {
                                new() { Id = "tc1", Name = "read_file" }
                            }
                        }
                    }.ToAsyncEnumerable();
                }
                return new[]
                {
                    new StreamChunk { Delta = "done", IsFinished = true, FinishReason = "stop" }
                }.ToAsyncEnumerable();
            });

        var events = await CollectEvents(orchestrator.StreamRunAsync("read", "s", DefaultOptions()));

        Assert.Contains(events, e => e is ToolCallStartEvent ts && ts.Call.Name == "read_file");
        Assert.Contains(events, e => e is ToolCallEndEvent te && te.Result.Content == "ok");
        Assert.Contains(events, e => e is AgentFinishedEvent);
    }
}