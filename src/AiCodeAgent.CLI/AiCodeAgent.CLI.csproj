<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>aiagent</AssemblyName>
    <RootNamespace>AiCodeAgent.CLI</RootNamespace>
    <Product>Vibe Coding Hub</Product>
    <Company>AIHelpers</Company>
    <Copyright>Copyright (c) 2026 AIHelpers</Copyright>
    <Description>Command-line tool for multi-agent AI coding workflows.</Description>
    <!-- dotnet tool package (dotnet tool install -g VibeCodingHub.Cli). The tool settings only take effect when packing
         with -p:PackAsTool=true (see release.yml), so the self-contained single-file publish of the CLI is not affected. -->
    <PackageId>VibeCodingHub.Cli</PackageId>
    <ToolCommandName>aiagent</ToolCommandName>
    <Authors>AIHelpers</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AIHelpers/vibe-coding-hub</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AIHelpers/vibe-coding-hub</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ai;agent;coding;llm;cli;dotnet-tool</PackageTags>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\packaging\icons\vibe-coding-hub.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <ProjectReference Include="..\AiCodeAgent.Core\AiCodeAgent.Core.csproj" />
    <ProjectReference Include="..\AiCodeAgent.Providers\AiCodeAgent.Providers.csproj" />
    <ProjectReference Include="..\AiCodeAgent.Tools\AiCodeAgent.Tools.csproj" />
    <ProjectReference Include="..\AiCodeAgent.Context\AiCodeAgent.Context.csproj" />
    <ProjectReference Include="..\AiCodeAgent.Indexing\AiCodeAgent.Indexing.csproj" />
    <ProjectReference Include="..\AiCodeAgent.LanguageServices\AiCodeAgent.LanguageServices.csproj" />
  </ItemGroup>
</Project>
