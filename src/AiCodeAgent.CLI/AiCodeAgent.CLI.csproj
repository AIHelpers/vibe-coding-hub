<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>aiagent</AssemblyName>
    <RootNamespace>AiCodeAgent.CLI</RootNamespace>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <ProjectReference Include="..\AiCodeAgent.Core\AiCodeAgent.Core.csproj" />
    <ProjectReference Include="..\AiCodeAgent.Providers\AiCodeAgent.Providers.csproj" />
    <ProjectReference Include="..\AiCodeAgent.Tools\AiCodeAgent.Tools.csproj" />
    <ProjectReference Include="..\AiCodeAgent.Context\AiCodeAgent.Context.csproj" />
    <ProjectReference Include="..\AiCodeAgent.LanguageServices\AiCodeAgent.LanguageServices.csproj" />
  </ItemGroup>
</Project>
