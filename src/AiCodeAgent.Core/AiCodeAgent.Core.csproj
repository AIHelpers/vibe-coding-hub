<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- The Unix pseudo-terminal calls forkpty/execve through function pointers (Terminal/UnixPty.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AiCodeAgent.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The model list lives with the providers; Core embeds it so defaults and the registry can read it. -->
    <EmbeddedResource Include="..\AiCodeAgent.Providers\models.json" LogicalName="AiCodeAgent.Providers.models.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- The example flows, characters and skills ship with the app: the Flows template gallery installs from them (ExampleLibrary). -->
    <EmbeddedResource Include="..\..\examples\pipelines\*.json" LogicalName="examples/pipelines/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\examples\characters\*.md" LogicalName="examples/characters/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\examples\skills\*\SKILL.md" LogicalName="examples/skills/%(RecursiveDir)SKILL.md" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AiCodeAgent.Core.Tests" />
  </ItemGroup>
</Project>