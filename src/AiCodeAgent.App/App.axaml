<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AiCodeAgent.App.App"
             xmlns:local="using:AiCodeAgent.App"
             xmlns:converters="using:AiCodeAgent.App.Converters"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="PrimaryColor">#0078D4</Color>
                    <Color x:Key="SecondaryColor">#106EBE</Color>
                    <Color x:Key="AccentColor">#FFB900</Color>
                    <Color x:Key="BackgroundColor">#FFFFFF</Color>
                    <Color x:Key="SurfaceColor">#F3F3F3</Color>
                    <Color x:Key="TextColor">#1A1A1A</Color>
                    <!-- Semantic theme tokens (E4-S2). Views use the *Brush resources; ThemeContrastTests checks every pair. -->
                    <Color x:Key="ThemeSurface">#FFFFFF</Color>
                    <Color x:Key="ThemeSurfaceRaised">#EEF0F6</Color>
                    <Color x:Key="ThemeBorder">#8A8FA3</Color>
                    <Color x:Key="ThemeText">#1A1A1A</Color>
                    <Color x:Key="ThemeTextMuted">#55556A</Color>
                    <Color x:Key="ThemeAccent">#0B5CAD</Color>
                    <Color x:Key="ThemeDanger">#B3261E</Color>
                    <Color x:Key="ThemeSuccess">#1B6E35</Color>
                    <Color x:Key="ThemeWarning">#7A5200</Color>
                    <Color x:Key="ThemeCodeBg">#F6F7FA</Color>
                    <Color x:Key="ThemeCodeFg">#1E1E2E</Color>
                    <Color x:Key="ThemeDangerSolid">#C62828</Color>
                    <Color x:Key="ThemeSuccessSolid">#2E7D32</Color>
                    <Color x:Key="ThemeAccentSolid">#0F6CBD</Color>
                    <Color x:Key="ThemeOnSolid">#FFFFFF</Color>
                    <Color x:Key="ThemeSyntaxKeyword">#0A3FBF</Color>
                    <Color x:Key="ThemeSyntaxType">#1F6F85</Color>
                    <Color x:Key="ThemeSyntaxMethod">#6B4F1D</Color>
                    <Color x:Key="ThemeSyntaxString">#A31515</Color>
                    <Color x:Key="ThemeSyntaxNumber">#0B6B4A</Color>
                    <Color x:Key="ThemeSyntaxComment">#4F6F3A</Color>
                    <Color x:Key="ThemeSyntaxTag">#A3215A</Color>
                    <Color x:Key="ThemeSyntaxAttribute">#9A3B00</Color>
                    <Color x:Key="ThemeSyntaxDirective">#8A2FA6</Color>
                    <Color x:Key="ThemeSyntaxHeading">#7A5200</Color>
                    <Color x:Key="ThemeSyntaxLink">#0A58A8</Color>
                    <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="{StaticResource ThemeSurface}"/>
                    <SolidColorBrush x:Key="ThemeSurfaceRaisedBrush" Color="{StaticResource ThemeSurfaceRaised}"/>
                    <SolidColorBrush x:Key="ThemeBorderBrush" Color="{StaticResource ThemeBorder}"/>
                    <SolidColorBrush x:Key="ThemeTextBrush" Color="{StaticResource ThemeText}"/>
                    <SolidColorBrush x:Key="ThemeTextMutedBrush" Color="{StaticResource ThemeTextMuted}"/>
                    <SolidColorBrush x:Key="ThemeAccentBrush" Color="{StaticResource ThemeAccent}"/>
                    <SolidColorBrush x:Key="ThemeDangerBrush" Color="{StaticResource ThemeDanger}"/>
                    <SolidColorBrush x:Key="ThemeSuccessBrush" Color="{StaticResource ThemeSuccess}"/>
                    <SolidColorBrush x:Key="ThemeWarningBrush" Color="{StaticResource ThemeWarning}"/>
                    <SolidColorBrush x:Key="ThemeCodeBgBrush" Color="{StaticResource ThemeCodeBg}"/>
                    <SolidColorBrush x:Key="ThemeCodeFgBrush" Color="{StaticResource ThemeCodeFg}"/>
                    <SolidColorBrush x:Key="ThemeDangerSolidBrush" Color="{StaticResource ThemeDangerSolid}"/>
                    <SolidColorBrush x:Key="ThemeSuccessSolidBrush" Color="{StaticResource ThemeSuccessSolid}"/>
                    <SolidColorBrush x:Key="ThemeAccentSolidBrush" Color="{StaticResource ThemeAccentSolid}"/>
                    <SolidColorBrush x:Key="ThemeOnSolidBrush" Color="{StaticResource ThemeOnSolid}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxKeywordBrush" Color="{StaticResource ThemeSyntaxKeyword}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxTypeBrush" Color="{StaticResource ThemeSyntaxType}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxMethodBrush" Color="{StaticResource ThemeSyntaxMethod}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxStringBrush" Color="{StaticResource ThemeSyntaxString}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxNumberBrush" Color="{StaticResource ThemeSyntaxNumber}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxCommentBrush" Color="{StaticResource ThemeSyntaxComment}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxTagBrush" Color="{StaticResource ThemeSyntaxTag}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxAttributeBrush" Color="{StaticResource ThemeSyntaxAttribute}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxDirectiveBrush" Color="{StaticResource ThemeSyntaxDirective}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxHeadingBrush" Color="{StaticResource ThemeSyntaxHeading}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxLinkBrush" Color="{StaticResource ThemeSyntaxLink}"/>
                    <SolidColorBrush x:Key="AppHeaderBrush" Color="#DDE1EA"/>
                    <SolidColorBrush x:Key="AppSubBrush" Color="#E9ECF3"/>
                    <SolidColorBrush x:Key="AppDeepBrush" Color="#EEF0F6"/>
                    <SolidColorBrush x:Key="AppInsetBrush" Color="#F3F4F8"/>
                    <SolidColorBrush x:Key="AppPopupBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AppHoverBrush" Color="#E0E4EE"/>
                    <SolidColorBrush x:Key="AppBadgeBrush" Color="#D5D9E3"/>
                    <SolidColorBrush x:Key="AppInfoBrush" Color="#E7F0FB"/>
                    <SolidColorBrush x:Key="AppInfoBorderBrush" Color="#9DBBE0"/>
                    <SolidColorBrush x:Key="AppSuccessBrush" Color="#E8F5E9"/>
                    <SolidColorBrush x:Key="AppSuccessBorderBrush" Color="#8BC48F"/>
                    <SolidColorBrush x:Key="AppDiffRemovedHeaderBrush" Color="#FBE4E4"/>
                    <SolidColorBrush x:Key="AppDiffRemovedBrush" Color="#FFF1F1"/>
                    <SolidColorBrush x:Key="AppDiffAddedHeaderBrush" Color="#E2F4E3"/>
                    <SolidColorBrush x:Key="AppDiffAddedBrush" Color="#F1FAF2"/>
                    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="{StaticResource ThemeCodeBg}"/>
                    <SolidColorBrush x:Key="EditorForegroundBrush" Color="{StaticResource ThemeCodeFg}"/>
                    <SolidColorBrush x:Key="EditorFrameBrush" Color="#F5F5F5"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="PrimaryColor">#60CDFF</Color>
                    <Color x:Key="SecondaryColor">#0078D4</Color>
                    <Color x:Key="AccentColor">#FFB900</Color>
                    <Color x:Key="BackgroundColor">#1F1F1F</Color>
                    <Color x:Key="SurfaceColor">#2D2D2D</Color>
                    <Color x:Key="TextColor">#FFFFFF</Color>
                    <!-- Semantic theme tokens (E4-S2). Views use the *Brush resources; ThemeContrastTests checks every pair. -->
                    <Color x:Key="ThemeSurface">#1E1E2E</Color>
                    <Color x:Key="ThemeSurfaceRaised">#2A2A3A</Color>
                    <Color x:Key="ThemeBorder">#6A6A80</Color>
                    <Color x:Key="ThemeText">#E8E8F0</Color>
                    <Color x:Key="ThemeTextMuted">#A6A6B8</Color>
                    <Color x:Key="ThemeAccent">#60CDFF</Color>
                    <Color x:Key="ThemeDanger">#FF8A8A</Color>
                    <Color x:Key="ThemeSuccess">#6FD08C</Color>
                    <Color x:Key="ThemeWarning">#F2C14E</Color>
                    <Color x:Key="ThemeCodeBg">#181825</Color>
                    <Color x:Key="ThemeCodeFg">#E8E8F0</Color>
                    <Color x:Key="ThemeDangerSolid">#C62828</Color>
                    <Color x:Key="ThemeSuccessSolid">#2E7D32</Color>
                    <Color x:Key="ThemeAccentSolid">#0F6CBD</Color>
                    <Color x:Key="ThemeOnSolid">#FFFFFF</Color>
                    <Color x:Key="ThemeSyntaxKeyword">#7CB7F0</Color>
                    <Color x:Key="ThemeSyntaxType">#4EC9B0</Color>
                    <Color x:Key="ThemeSyntaxMethod">#DCDCAA</Color>
                    <Color x:Key="ThemeSyntaxString">#E0A084</Color>
                    <Color x:Key="ThemeSyntaxNumber">#B5CEA8</Color>
                    <Color x:Key="ThemeSyntaxComment">#8FB379</Color>
                    <Color x:Key="ThemeSyntaxTag">#F08FAA</Color>
                    <Color x:Key="ThemeSyntaxAttribute">#9CDCFE</Color>
                    <Color x:Key="ThemeSyntaxDirective">#D18FD0</Color>
                    <Color x:Key="ThemeSyntaxHeading">#F2C14E</Color>
                    <Color x:Key="ThemeSyntaxLink">#6CB6FF</Color>
                    <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="{StaticResource ThemeSurface}"/>
                    <SolidColorBrush x:Key="ThemeSurfaceRaisedBrush" Color="{StaticResource ThemeSurfaceRaised}"/>
                    <SolidColorBrush x:Key="ThemeBorderBrush" Color="{StaticResource ThemeBorder}"/>
                    <SolidColorBrush x:Key="ThemeTextBrush" Color="{StaticResource ThemeText}"/>
                    <SolidColorBrush x:Key="ThemeTextMutedBrush" Color="{StaticResource ThemeTextMuted}"/>
                    <SolidColorBrush x:Key="ThemeAccentBrush" Color="{StaticResource ThemeAccent}"/>
                    <SolidColorBrush x:Key="ThemeDangerBrush" Color="{StaticResource ThemeDanger}"/>
                    <SolidColorBrush x:Key="ThemeSuccessBrush" Color="{StaticResource ThemeSuccess}"/>
                    <SolidColorBrush x:Key="ThemeWarningBrush" Color="{StaticResource ThemeWarning}"/>
                    <SolidColorBrush x:Key="ThemeCodeBgBrush" Color="{StaticResource ThemeCodeBg}"/>
                    <SolidColorBrush x:Key="ThemeCodeFgBrush" Color="{StaticResource ThemeCodeFg}"/>
                    <SolidColorBrush x:Key="ThemeDangerSolidBrush" Color="{StaticResource ThemeDangerSolid}"/>
                    <SolidColorBrush x:Key="ThemeSuccessSolidBrush" Color="{StaticResource ThemeSuccessSolid}"/>
                    <SolidColorBrush x:Key="ThemeAccentSolidBrush" Color="{StaticResource ThemeAccentSolid}"/>
                    <SolidColorBrush x:Key="ThemeOnSolidBrush" Color="{StaticResource ThemeOnSolid}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxKeywordBrush" Color="{StaticResource ThemeSyntaxKeyword}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxTypeBrush" Color="{StaticResource ThemeSyntaxType}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxMethodBrush" Color="{StaticResource ThemeSyntaxMethod}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxStringBrush" Color="{StaticResource ThemeSyntaxString}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxNumberBrush" Color="{StaticResource ThemeSyntaxNumber}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxCommentBrush" Color="{StaticResource ThemeSyntaxComment}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxTagBrush" Color="{StaticResource ThemeSyntaxTag}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxAttributeBrush" Color="{StaticResource ThemeSyntaxAttribute}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxDirectiveBrush" Color="{StaticResource ThemeSyntaxDirective}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxHeadingBrush" Color="{StaticResource ThemeSyntaxHeading}"/>
                    <SolidColorBrush x:Key="ThemeSyntaxLinkBrush" Color="{StaticResource ThemeSyntaxLink}"/>
                    <SolidColorBrush x:Key="AppHeaderBrush" Color="#2A2A3A"/>
                    <SolidColorBrush x:Key="AppSubBrush" Color="#22222E"/>
                    <SolidColorBrush x:Key="AppDeepBrush" Color="#1A1A2A"/>
                    <SolidColorBrush x:Key="AppInsetBrush" Color="#1E1E2E"/>
                    <SolidColorBrush x:Key="AppPopupBrush" Color="#2D2D3D"/>
                    <SolidColorBrush x:Key="AppHoverBrush" Color="#26263A"/>
                    <SolidColorBrush x:Key="AppBadgeBrush" Color="#3A3A4A"/>
                    <SolidColorBrush x:Key="AppInfoBrush" Color="#1E2A3A"/>
                    <SolidColorBrush x:Key="AppInfoBorderBrush" Color="#3A5A8A"/>
                    <SolidColorBrush x:Key="AppSuccessBrush" Color="#1A2A1A"/>
                    <SolidColorBrush x:Key="AppSuccessBorderBrush" Color="#2A6A2A"/>
                    <SolidColorBrush x:Key="AppDiffRemovedHeaderBrush" Color="#241A1A"/>
                    <SolidColorBrush x:Key="AppDiffRemovedBrush" Color="#1A1414"/>
                    <SolidColorBrush x:Key="AppDiffAddedHeaderBrush" Color="#1A241A"/>
                    <SolidColorBrush x:Key="AppDiffAddedBrush" Color="#141A14"/>
                    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="{StaticResource ThemeCodeBg}"/>
                    <SolidColorBrush x:Key="EditorForegroundBrush" Color="{StaticResource ThemeCodeFg}"/>
                    <SolidColorBrush x:Key="EditorFrameBrush" Color="#181825"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Value Converters -->
            <converters:BoolToStatusIconConverter x:Key="BoolToStatusIcon"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:BoolToErrorBrushConverter x:Key="BoolToErrorBrush"/>
            <converters:InverseBoolConverter x:Key="InverseBool"/>
            <converters:BoolToActiveTabBrushConverter x:Key="BoolToActiveTabBrush"/>
            <converters:StringNotEmptyConverter x:Key="StringNotEmpty"/>
            <converters:BoolToStarGridLengthConverter x:Key="BoolToStarGridLength"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>