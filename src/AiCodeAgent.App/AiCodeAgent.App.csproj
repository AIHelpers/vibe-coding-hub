<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Vibe Coding Hub</AssemblyName>
    <RootNamespace>AiCodeAgent.App</RootNamespace>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.0" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.2.0" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.2.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Markdown.Avalonia" Version="11.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <!-- Pinned to override the vulnerable Tmds.DBus.Protocol that Avalonia.FreeDesktop 11.2.x pulls in transitively.
         Must stay API-compatible with the 0.20.x line Avalonia.FreeDesktop 11.2.0 was compiled against: 0.21.x is OK;
         0.9x removed Tmds.DBus.Protocol.Connection and crashes Linux startup with TypeLoadException.
         Revisit (or drop the pin) when upgrading Avalonia to 11.3.x. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AiCodeAgent.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AiCodeAgent.Core\AiCodeAgent.Core.csproj" />
    <ProjectReference Include="..\AiCodeAgent.Providers\AiCodeAgent.Providers.csproj" />
    <ProjectReference Include="..\AiCodeAgent.Tools\AiCodeAgent.Tools.csproj" />
    <ProjectReference Include="..\AiCodeAgent.Context\AiCodeAgent.Context.csproj" />
    <ProjectReference Include="..\AiCodeAgent.Indexing\AiCodeAgent.Indexing.csproj" />
    <ProjectReference Include="..\AiCodeAgent.LanguageServices\AiCodeAgent.LanguageServices.csproj" />
  </ItemGroup>
</Project>