<UserControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:AiCodeAgent.App.ViewModels"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d"
                x:Class="AiCodeAgent.App.Views.SettingsView"
                x:DataType="vm:SettingsViewModel">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="600">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="⚙️ Settings" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Configure your AI agent settings" Opacity="0.6" FontSize="13"/>
            </StackPanel>

            <!-- Provider Selection -->
            <StackPanel Spacing="4">
                <TextBlock Text="AI Provider" FontSize="13" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding AvailableProviders}"
                          SelectedItem="{Binding SelectedProvider}"
                          Width="300"/>
            </StackPanel>

            <!-- Base URL -->
            <StackPanel Spacing="4">
                <TextBlock Text="Base URL" FontSize="13" FontWeight="SemiBold"/>
                <TextBox Text="{Binding BaseUrl}"
                         Width="400"
                         Watermark="e.g. http://localhost:1234"/>
                <TextBlock Text="Custom URL for local providers (LM Studio, vLLM, LocalAI, etc.)"
                           Opacity="0.6" FontSize="12"/>
            </StackPanel>

            <!-- Model -->
            <StackPanel Spacing="4">
                <TextBlock Text="Model" FontSize="13" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,Auto,Auto" Width="400">
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding AvailableModels}"
                              SelectedItem="{Binding Model}"
                              PlaceholderText="Select a model"
                              ToolTip.Tip="Select a model from the list"
                              MinWidth="300"
                              VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="🔄"
                            Command="{Binding RefreshModelsCommand}"
                            Width="28" Height="28"
                            Margin="4,0,0,0"
                            ToolTip.Tip="Load / refresh available models"
                            VerticalAlignment="Center"/>
                    <ProgressBar Grid.Column="2"
                                 IsVisible="{Binding IsLoadingModels}"
                                 IsIndeterminate="True"
                                 Width="20" Height="20"
                                 Margin="8,0,0,0"
                                 VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding ModelsStatus}"
                            Opacity="0.6" FontSize="12"/>
            </StackPanel>

            <!-- API Key -->
            <StackPanel Spacing="4">
                <TextBlock Text="API Key" FontSize="13" FontWeight="SemiBold"/>
                <TextBox Text="{Binding ApiKey}"
                         PasswordChar="●"
                         Width="400"/>
                <TextBlock Text="Optional for local providers, required for cloud providers"
                           Opacity="0.6" FontSize="12"/>
            </StackPanel>

            <!-- SSL Verification -->
            <StackPanel Spacing="4">
                <TextBlock Text="SSL Verification" FontSize="13" FontWeight="SemiBold"/>
                <CheckBox IsChecked="{Binding VerifySsl}"
                          Content="Verify SSL certificates (disable for local dev with self-signed certs)"
                          FontSize="13"/>
            </StackPanel>

            <!-- Working Directory -->
            <StackPanel Spacing="4">
                <TextBlock Text="Working Directory" FontSize="13" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding WorkingDirectory}"
                             IsReadOnly="True"
                             Margin="0,0,8,0"/>
                    <Button Grid.Column="1"
                            Content="Browse…"
                            Command="{Binding BrowseDirectoryCommand}"
                            Width="90" Height="28"/>
                </Grid>
            </StackPanel>

            <!-- Permission Mode -->
            <StackPanel Spacing="4">
                <TextBlock Text="Permission Mode" FontSize="13" FontWeight="SemiBold"/>
                <CheckBox IsChecked="{Binding AutoApprove}"
                          Content="Auto-approve tool calls (FullAuto)"
                          FontSize="13"/>
            </StackPanel>

            <!-- Save Button -->
            <Button Content="💾 Save Settings"
                    Command="{Binding SaveCommand}"
                    HorizontalAlignment="Left"
                    Padding="16,8"
                    Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>