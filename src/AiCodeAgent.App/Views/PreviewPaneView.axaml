<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AiCodeAgent.App.ViewModels"
        xmlns:views="using:AiCodeAgent.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="600"
        x:Class="AiCodeAgent.App.Views.PreviewPaneView"
        x:DataType="vm:PreviewPaneViewModel">

    <Design.DataContext>
        <vm:PreviewPaneViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Background="#2A2A3A" Margin="8,4">
            <TextBlock Grid.Column="0" Text="👁️ Preview" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="✏️ Annotate" Command="{Binding ToggleAnnotationCommand}" Padding="8,4" FontSize="10" Margin="4,0"/>
            <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="10" Opacity="0.6" VerticalAlignment="Center"/>
        </Grid>

        <!-- Annotation toolbar -->
        <Border Grid.Row="1" Background="#1E1E2E" Padding="6,4" IsVisible="{Binding IsAnnotationActive}">
            <WrapPanel Orientation="Horizontal">
                <RadioButton Content="Pen" IsChecked="{Binding Annotation.IsPenTool}" Margin="2,0" FontSize="10" GroupName="AnnTool"/>
                <RadioButton Content="Highlighter" IsChecked="{Binding Annotation.IsHighlighterTool}" Margin="2,0" FontSize="10" GroupName="AnnTool"/>
                <RadioButton Content="Arrow" IsChecked="{Binding Annotation.IsArrowTool}" Margin="2,0" FontSize="10" GroupName="AnnTool"/>
                <RadioButton Content="Text" IsChecked="{Binding Annotation.IsTextTool}" Margin="2,0" FontSize="10" GroupName="AnnTool"/>
                <RadioButton Content="Eraser" IsChecked="{Binding Annotation.IsEraserTool}" Margin="2,0" FontSize="10" GroupName="AnnTool"/>
            </WrapPanel>
        </Border>

        <!-- Preview elements list (mock rendered preview) with annotation overlay -->
        <Grid Grid.Row="2">
            <ScrollViewer Padding="4">
            <ItemsControl ItemsSource="{Binding Elements}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:PreviewElement">
                        <Border Padding="8,5" Margin="0,2" CornerRadius="4"
                                Background="#1E1E2E"
                                BorderBrush="#333"
                                BorderThickness="1"
                                Cursor="Hand"
                                PointerPressed="OnElementClicked"
                                Tag="{Binding}">
                            <Border.Styles>
                                <Style Selector="Border:pointerover">
                                    <Setter Property="Background" Value="#26263A"/>
                                </Style>
                            </Border.Styles>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Label}" FontSize="12" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DataSourceId}" FontSize="9" Opacity="0.45" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
            <!-- Freehand annotation overlay -->
            <views:AnnotationCanvasView DataContext="{Binding Annotation}" IsVisible="{Binding IsActive}"/>
            <!-- Annotation action bar -->
            <Border VerticalAlignment="Bottom" Background="#1A1A2A" Padding="6,4" IsVisible="{Binding IsActive}">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <TextBox Text="{Binding Note}" Watermark="Note…" Width="120" FontSize="10"/>
                    <Button Content="Send" Command="{Binding CommitCommand}" Padding="8,4" FontSize="10" Background="#2266AA" Foreground="White"/>
                    <Button Content="Undo" Command="{Binding UndoCommand}" Padding="8,4" FontSize="10"/>
                    <Button Content="Clear" Command="{Binding ClearCommand}" Padding="8,4" FontSize="10"/>
                    <Button Content="✕" Command="{Binding CancelCommand}" Padding="8,4" FontSize="10"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Property panel -->
        <Border Grid.Row="3" Background="#1A1A2A" Padding="8" MinHeight="140">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="0,2">
                <TextBlock Grid.Row="0" Text="Properties" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"
                           IsVisible="{Binding SelectedElement, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <TextBlock Grid.Row="0" Text="No element selected" FontSize="11" Opacity="0.5"
                           IsVisible="{Binding SelectedElement, Converter={x:Static ObjectConverters.IsNull}}"/>

                <TextBox Grid.Row="1" Text="{Binding PropertyText}" Watermark="Text" Margin="0,2" FontSize="11"/>
                <TextBox Grid.Row="2" Text="{Binding PropertyColor}" Watermark="color" Margin="0,2" FontSize="11"/>
                <TextBox Grid.Row="3" Text="{Binding PropertyFontSize}" Watermark="font-size" Margin="0,2" FontSize="11"/>
                <TextBox Grid.Row="4" Text="{Binding PropertyPadding}" Watermark="padding" Margin="0,2" FontSize="11"/>

                <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button Content="Apply" Command="{Binding ApplyEditCommand}" Padding="12,6" FontSize="11" Background="#22AA22" Foreground="White"/>
                    <Button Content="Clear" Command="{Binding ClearSelectionCommand}" Padding="12,6" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>