<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AiCodeAgent.App.ViewModels"
             xmlns:views="using:AiCodeAgent.App.Views"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:mdtight="https://github.com/whistyun/Markdown.Avalonia.Tight"
             x:Class="AiCodeAgent.App.Views.ChatTimelineView"
             x:DataType="vm:ChatTimeline"
             x:CompileBindings="True">
    <!-- The whole chat as one chronological list (E2-S2/E2-S3): one ItemsControl, one DataTemplate per item type. -->
    <Grid>
        <ScrollViewer Name="TimelineScroll" Margin="0,0,0,8">
            <ItemsControl Name="TimelineItems" ItemsSource="{Binding Items}" Margin="16,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>

                    <DataTemplate DataType="vm:UserMessageItem">
                        <Border Classes="chat-user" Margin="48,4,0,4" Padding="12"
                                Background="{DynamicResource AppInfoBrush}"
                                BorderBrush="{DynamicResource AppInfoBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RewindLabel}"
                                               IsVisible="{Binding HasRewindNumber}"
                                               ToolTip.Tip="Message number for /rewind and /fork"
                                               FontSize="11" Opacity="0.5" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Timestamp, StringFormat='{}{0:t}'}" FontSize="10" Opacity="0.4"/>
                                    <Button Grid.Column="4" Content="📋" ToolTip.Tip="Copy message"
                                            Click="CopyTextButton_ClickAsync"
                                            FontSize="11" Padding="4,2" Margin="8,0,0,0" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0"/>
                                </Grid>
                                <md:MarkdownScrollViewer Markdown="{Binding Content}">
                                    <md:MarkdownScrollViewer.Plugins>
                                        <md:MdAvPlugins>
                                            <mdtight:ChatAISetup/>
                                        </md:MdAvPlugins>
                                    </md:MarkdownScrollViewer.Plugins>
                                </md:MarkdownScrollViewer>
                            </StackPanel>
                        </Border>
                    </DataTemplate>

                    <DataTemplate DataType="vm:AssistantTextItem">
                        <!-- Hidden while empty so a step that only calls tools leaves no blank bubble. -->
                        <Border Classes="chat-assistant" Margin="0,4" Padding="12"
                                IsVisible="{Binding HasContent}"
                                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                CornerRadius="8">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Timestamp, StringFormat='{}{0:t}'}" FontSize="10" Opacity="0.4"/>
                                    <Button Grid.Column="3" Content="📋" ToolTip.Tip="Copy message"
                                            Click="CopyTextButton_ClickAsync"
                                            FontSize="11" Padding="4,2" Margin="8,0,0,0" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0"/>
                                </Grid>
                                <md:MarkdownScrollViewer Markdown="{Binding Content}">
                                    <md:MarkdownScrollViewer.Plugins>
                                        <md:MdAvPlugins>
                                            <mdtight:ChatAISetup/>
                                        </md:MdAvPlugins>
                                    </md:MarkdownScrollViewer.Plugins>
                                </md:MarkdownScrollViewer>
                            </StackPanel>
                        </Border>
                    </DataTemplate>

                    <DataTemplate DataType="vm:SystemNoticeItem">
                        <Border Classes="chat-notice" Margin="0,2" Padding="10,6"
                                Background="{DynamicResource AppInsetBrush}"
                                CornerRadius="6" Opacity="0.85">
                            <md:MarkdownScrollViewer Markdown="{Binding Content}">
                                <md:MarkdownScrollViewer.Plugins>
                                    <md:MdAvPlugins>
                                        <mdtight:ChatAISetup/>
                                    </md:MdAvPlugins>
                                </md:MarkdownScrollViewer.Plugins>
                            </md:MarkdownScrollViewer>
                        </Border>
                    </DataTemplate>

                    <DataTemplate DataType="vm:ToolCallItem">
                        <views:ToolCallCardView DataContext="{Binding Card}"/>
                    </DataTemplate>

                    <DataTemplate DataType="vm:ApprovalItem">
                        <Border Classes="chat-approval" Margin="0,4" Padding="10"
                                Background="{DynamicResource AppInfoBrush}"
                                BorderBrush="{DynamicResource AppInfoBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Subtitle, StringFormat='· {0}'}"
                                               IsVisible="{Binding HasSubtitle}"
                                               ToolTip.Tip="{Binding Arguments}"
                                               FontSize="12" Opacity="0.75" Margin="6,0,0,0" MaxWidth="420"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Border Grid.Column="3" CornerRadius="3" Padding="4,1"
                                            Background="{DynamicResource AppBadgeBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Risk, StringFormat='risk: {0}'}" FontSize="10"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding AgentRole, StringFormat='from {0}'}"
                                           IsVisible="{Binding AgentRole, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           FontSize="11" Opacity="0.6"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="12"
                                           Classes.pending="{Binding IsPending}"
                                           Classes.approved="{Binding IsApproved}"
                                           Classes.declined="{Binding IsDeclined}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>

                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>

        <!-- Shown when the user has scrolled up and new output arrived below. -->
        <Button Name="NewMessagesPill"
                Content="↓ New messages"
                IsVisible="{Binding AutoScroll.ShowNewMessagesPill}"
                Command="{Binding AutoScroll.JumpToLatestCommand}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,20"
                Padding="14,5"
                CornerRadius="14"
                FontSize="12"
                Cursor="Hand"/>
    </Grid>

    <UserControl.Styles>
        <Style Selector="TextBlock.pending">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <Style Selector="TextBlock.approved">
            <Setter Property="Foreground" Value="#43A047"/>
        </Style>
        <Style Selector="TextBlock.declined">
            <Setter Property="Foreground" Value="#E53935"/>
        </Style>
    </UserControl.Styles>
</UserControl>
