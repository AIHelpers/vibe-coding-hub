<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AiCodeAgent.App.ViewModels"
        xmlns:views="using:AiCodeAgent.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="AiCodeAgent.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Vibe Coding Hub - AI Code Agent"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Window.KeyBindings>
        <!-- Ctrl+L: Clear Chat -->
        <KeyBinding Gesture="Ctrl+L" Command="{Binding ChatViewModel.ClearChatCommand}"/>
        <!-- Ctrl+Enter: Send -->
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding ChatViewModel.SendCommand}"/>
        <!-- Escape: Cancel/Stop -->
        <KeyBinding Gesture="Escape" Command="{Binding ChatViewModel.CancelCommand}"/>
        <!-- Ctrl+B: Toggle File Explorer -->
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleFileExplorerCommand}"/>
        <!-- Ctrl+`: Toggle Terminal -->
        <KeyBinding Gesture="Ctrl+Oem3" Command="{Binding ToggleTerminalCommand}"/>
        <!-- Ctrl+Shift+P: Open Settings -->
        <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding NavigateToSettingsCommand}"/>
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,*,Auto" Name="RootGrid">
        <!-- Header / Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">
                <!-- App Logo/Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Text="Vibe Coding Hub" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Toolbar Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Content="📁" Command="{Binding ToggleFileExplorerCommand}" 
                            ToolTip.Tip="Toggle File Explorer (Ctrl+B)" 
                            Width="32" Height="28" Padding="0"/>
                    <Button Content="💻" Command="{Binding ToggleTerminalCommand}" 
                            ToolTip.Tip="Toggle Terminal (Ctrl+`)" 
                            Width="32" Height="28" Padding="0"/>
                    <Button Content="📄" Command="{Binding ToggleCheckpointBrowserCommand}" 
                            ToolTip.Tip="Toggle Checkpoint Browser" 
                            Width="32" Height="28" Padding="0"/>
                    <Button Content="🔄" Command="{Binding RefreshFileExplorerCommand}" 
                            ToolTip.Tip="Refresh File Explorer" 
                            Width="32" Height="28" Padding="0"/>
                </StackPanel>

                <!-- Spacer -->
                <TextBlock Grid.Column="2" Text=""/>

                <!-- Model Selector -->
                <ComboBox Grid.Column="3" 
                          ItemsSource="{Binding ChatViewModel.AvailableModels}"
                          SelectedItem="{Binding ChatViewModel.SelectedModel}"
                          VerticalAlignment="Center"
                          Width="80"
                          Margin="4,0">
                    <ComboBox.Styles>
                        <Style Selector="ComboBox">
                            <Setter Property="FontSize" Value="12"/>
                        </Style>
                    </ComboBox.Styles>
                </ComboBox>

                <!-- Permission Mode Selector -->
                <ComboBox Grid.Column="4" 
                          SelectedItem="{Binding ChatViewModel.PermissionMode}"
                          VerticalAlignment="Center"
                          Width="80"
                          Margin="4,0">
                    <ComboBoxItem Content="Ask" />
                    <ComboBoxItem Content="AutoEdit" />
                    <ComboBoxItem Content="FullAuto" />
                    <ComboBoxItem Content="Plan" />
                </ComboBox>

                <!-- Navigation -->
                <Button Grid.Column="5" Content="⚙️" 
                        Command="{Binding NavigateToSettingsCommand}"
                        ToolTip.Tip="Settings (Ctrl+Shift+P)"
                        Width="32" Height="28" Padding="0" Margin="4,0"/>

                <!-- Cancel Button -->
                <Button Grid.Column="6" 
                        Content="⏹" 
                        IsVisible="{Binding ChatViewModel.IsCancellable}"
                        Command="{Binding ChatViewModel.CancelCommand}"
                        ToolTip.Tip="Stop generating (Esc)"
                        Background="#FF4444" 
                        Foreground="White"
                        Width="32" Height="28" Padding="0" Margin="4,0"/>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!-- Settings Content - shown when IsSettingsMode is true -->
            <ContentControl Grid.Row="0"
                            Content="{Binding CurrentViewModel}"
                            IsVisible="{Binding IsSettingsMode}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            ZIndex="10">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <views:SettingsView/>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>

            <!-- Checkpoint Browser Overlay -->
            <Border IsVisible="{Binding IsCheckpointBrowserOpen}"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="4"
                    Margin="8"
                    Padding="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="360"
                    ZIndex="50">
                <views:CheckpointBrowserView DataContext="{Binding CheckpointBrowser}"/>
            </Border>

            <!-- SplitView for sidebar (visible in Chat mode) -->
            <SplitView Name="MainSplitView"
                       IsPaneOpen="{Binding IsFileExplorerOpen}"
                       DisplayMode="CompactInline"
                       OpenPaneLength="280"
                       CompactPaneLength="40"
                       IsVisible="{Binding IsSettingsMode, Converter={StaticResource InverseBool}}">

                <!-- File Explorer Pane (Left Sidebar) -->
                <SplitView.Pane>
                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" Padding="8">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <TextBlock Grid.Column="0" Text="📁 Explorer" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" 
                                        Content="🔄" 
                                        Command="{Binding RefreshFileExplorerCommand}"
                                        Width="24" Height="24" Padding="0" FontSize="12"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" Margin="0,0,0,8">
                                <TreeView ItemsSource="{Binding FileExplorer.RootItems}">
                                    <TreeView.ItemTemplate>
                                        <TreeDataTemplate ItemsSource="{Binding Children}" DataType="vm:FileExplorerItem">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Icon}" FontSize="14"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="⏳" 
                                                           IsVisible="{Binding IsLoading}" 
                                                           FontSize="10" 
                                                           Foreground="#888"/>
                                            </StackPanel>
                                        </TreeDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </ScrollViewer>
                            <Border Grid.Row="2" Background="#1A1A2A" CornerRadius="4" Padding="6">
                                <TextBlock Text="{Binding FileExplorer.RootPath}" 
                                           FontSize="10" 
                                           Opacity="0.5" 
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </Grid>
                    </Border>
                </SplitView.Pane>

                <!-- Main Content (Editor + Chat + Terminal) -->
                <SplitView.Content>
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Left Column: Editor + Chat stacked -->
                        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,Auto">
                            <!-- Editor Pane (Top, shown when a file is open) -->
                            <Border Grid.Row="0"
                                    IsVisible="{Binding EditorPane.ActiveTab}"
                                    Background="#1E1E2E"
                                    CornerRadius="4"
                                    Margin="0,0,0,8"
                                    MinHeight="100"
                                    MaxHeight="300">
                                <views:EditorView/>
                            </Border>

                            <!-- Chat Messages -->
                            <ScrollViewer Grid.Row="1" Margin="0,0,0,8">
                                <StackPanel Spacing="8" Margin="16,0">
                                    <ItemsControl ItemsSource="{Binding ChatViewModel.Messages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ChatMessage">
                                                <Border Margin="0,4" Padding="12" 
                                                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                                                        CornerRadius="8">
                                                    <StackPanel Spacing="4">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <TextBlock Grid.Column="0" 
                                                                       Text="{Binding Role}" 
                                                                       FontWeight="SemiBold" 
                                                                       FontSize="12" 
                                                                       Opacity="0.7"
                                                                       Padding="0,0,8,0"/>
                                                            <TextBlock Grid.Column="2" 
                                                                       Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" 
                                                                       FontSize="10" 
                                                                       Opacity="0.4"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Content}" 
                                                                   TextWrapping="Wrap"
                                                                   FontSize="13"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding ChatViewModel.ToolCallCards}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ToolCallCardViewModel">
                                                <Border Margin="0,4" Padding="10" 
                                                        Background="#2A2A3A" 
                                                        CornerRadius="8" 
                                                        BorderThickness="1">
                                                    <StackPanel Spacing="4">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ToolName, StringFormat='🔧 {}{0}'}" 
                                                                           FontWeight="Bold" 
                                                                           FontSize="13"/>
                                                                <Border CornerRadius="3" Padding="3,1" 
                                                                        Background="#333">
                                                                    <TextBlock Text="{Binding IsError}" 
                                                                               FontSize="10"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" 
                                                                       Text="{Binding Duration}" 
                                                                       FontSize="11" 
                                                                       Opacity="0.6"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0"/>
                                                            <Button Grid.Column="3" 
                                                                    Content="▶" 
                                                                    PointerPressed="OnToolCardExpandToggle"
                                                                    Width="20" Height="20" Padding="0" FontSize="10"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Arguments}" 
                                                                   FontSize="11" 
                                                                   Opacity="0.5" 
                                                                   TextWrapping="Wrap"/>
                                                        <Border Background="#1A1A2A" 
                                                                CornerRadius="4" 
                                                                Padding="8" 
                                                                IsVisible="{Binding IsExpanded}">
                                                            <TextBlock Text="{Binding Output}" 
                                                                       FontSize="11" 
                                                                       FontFamily="Consolas" 
                                                                       TextWrapping="Wrap"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Terminal Pane -->
                            <Border Grid.Row="2" 
                                    IsVisible="{Binding Terminal.IsVisible}" 
                                    Background="#1E1E2E" 
                                    CornerRadius="4" 
                                    Margin="16,0,16,4"
                                    MinHeight="100"
                                    MaxHeight="400">
                                <Grid RowDefinitions="Auto,*">
                                    <Border Grid.Row="0" Background="#2A2A3A" Padding="8,4" CornerRadius="4,4,0,0">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="💻 Terminal" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding Terminal.IsRunning}" 
                                                       FontSize="11" 
                                                       Opacity="0.5" 
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                            <Button Grid.Column="3" 
                                                    Content="🗑️" 
                                                    Command="{Binding Terminal.ClearCommand}"
                                                    Width="20" Height="20" Padding="0" FontSize="10"/>
                                        </Grid>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" Margin="4">
                                        <ItemsControl ItemsSource="{Binding Terminal.Entries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:TerminalEntry">
                                                    <TextBlock Text="{Binding Text}" 
                                                               FontSize="11" 
                                                               FontFamily="Consolas" 
                                                               TextWrapping="Wrap"
                                                               Foreground="{Binding IsError, Converter={StaticResource BoolToErrorBrush}}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Input Area -->
                            <Grid Grid.Row="3" Margin="16,8,16,16" ColumnDefinitions="*,Auto,Auto">
                                <Grid Grid.Column="0" RowDefinitions="*,Auto">
                                    <Popup Grid.Row="0" 
                                           IsOpen="{Binding ChatViewModel.ShowMentionPopup}"
                                           Placement="Top"
                                           PlacementTarget="{Binding #InputBox}">
                                        <Border Background="#2D2D3D" 
                                                CornerRadius="8" 
                                                Padding="4" 
                                                MinWidth="200" 
                                                MaxWidth="350"
                                                MaxHeight="200">
                                            <ScrollViewer>
                                                <ItemsControl ItemsSource="{Binding ChatViewModel.MentionItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="vm:MentionItem">
                                                            <Border Padding="6,4" CornerRadius="4" PointerPressed="OnMentionSelected">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="14" Margin="0,0,8,0"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding FilePath}" FontSize="10" Opacity="0.5" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>

                                    <Popup Grid.Row="0" 
                                           IsOpen="{Binding ChatViewModel.ShowSlashCommands}"
                                           Placement="Top"
                                           PlacementTarget="{Binding #InputBox}">
                                        <Border Background="#2D2D3D" 
                                                CornerRadius="8" 
                                                Padding="4" 
                                                MinWidth="250" 
                                                MaxHeight="250">
                                            <ScrollViewer>
                                                <ItemsControl ItemsSource="{Binding ChatViewModel.SlashCommandItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="vm:SlashCommandItem">
                                                            <Border Padding="8,6" CornerRadius="4" PointerPressed="OnSlashCommandSelected">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="14" Margin="0,0,8,0"/>
                                                                    <StackPanel Grid.Column="1" Orientation="Vertical">
                                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold"/>
                                                                        <TextBlock Text="{Binding Description}" FontSize="10" Opacity="0.6"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>

                                    <TextBox Name="InputBox" 
                                             Grid.Row="0"
                                             Text="{Binding ChatViewModel.InputText}"
                                             Watermark="Type a message or / for commands... (@ to mention files)"
                                             AcceptsReturn="False"
                                             KeyDown="OnInputKeyDown"
                                             TextChanged="OnInputTextChanged"
                                             MinHeight="36"/>
                                    <TextBlock Grid.Row="1" 
                                               Text="{Binding ChatViewModel.TokenCount}" 
                                               FontSize="10" 
                                               Opacity="0.4" 
                                               HorizontalAlignment="Right"
                                               Margin="0,2,4,0"/>
                                </Grid>

                                <Button Grid.Column="1" 
                                        Content="➤ Send" 
                                        Command="{Binding ChatViewModel.SendCommand}" 
                                        Margin="8,0,0,0" 
                                        Padding="16,8"
                                        MinHeight="36"/>
                                <Button Grid.Column="2" 
                                        Content="🗑️" 
                                        Command="{Binding ChatViewModel.ClearChatCommand}"
                                        ToolTip.Tip="Clear Chat (Ctrl+L)"
                                        Width="36" Height="36" Padding="0" Margin="4,0,0,0"/>
                            </Grid>
                        </Grid>

                        <!-- Agent Session Sidebar (Right) -->
                        <Border Grid.Column="1" 
                                IsVisible="{Binding ChatViewModel.IsAgentSidebarOpen}"
                                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                                Padding="8" 
                                Margin="8,0,0,8"
                                MinWidth="180"
                                MaxWidth="220">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Text="🤖 Agents" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" 
                                            Content="✕" 
                                            Command="{Binding ChatViewModel.ToggleAgentSidebarCommand}"
                                            Width="20" Height="20" Padding="0" FontSize="10"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1">
                                    <ItemsControl ItemsSource="{Binding ChatViewModel.AgentSessions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:AgentSessionItem">
                                                <Border Margin="0,2" Padding="8" Background="#2A2A3A" CornerRadius="6">
                                                    <StackPanel Spacing="2">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <TextBlock Grid.Column="0" Text="🤖" FontSize="12" Margin="0,0,6,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding AgentId}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="10" Opacity="0.6"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Role}" FontSize="10" Opacity="0.5"/>
                                                        <TextBlock Text="{Binding PermissionMode, StringFormat='Mode: {}{0}'}" FontSize="10" Opacity="0.4"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </SplitView.Content>
            </SplitView>
        </Grid>
    </Grid>
</Window>