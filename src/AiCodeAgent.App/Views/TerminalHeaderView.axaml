<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AiCodeAgent.App.ViewModels"
             x:Class="AiCodeAgent.App.Views.TerminalHeaderView"
             x:DataType="vm:TerminalViewModel">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="💻 Terminal" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <!-- Only shown while a command runs; nothing at all when idle (never "True"/"False"). -->
        <StackPanel Grid.Column="2"
                    Name="RunningIndicator"
                    Orientation="Horizontal"
                    Spacing="4"
                    IsVisible="{Binding IsRunning}"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">
            <Ellipse Width="7" Height="7" Fill="{DynamicResource ThemeSuccessBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="running" FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="3"
                Content="🗑️"
                Command="{Binding ClearCommand}"
                ToolTip.Tip="Clear terminal"
                Width="20" Height="20" Padding="0" FontSize="10"/>
    </Grid>
</UserControl>
