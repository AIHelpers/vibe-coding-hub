<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AiCodeAgent.App.ViewModels"
             xmlns:core="using:AiCodeAgent.Core.Interfaces"
             x:Class="AiCodeAgent.App.Views.ProjectKnowledgeView"
             x:DataType="vm:ProjectKnowledgeViewModel">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource AppHeaderBrush}" Padding="10" CornerRadius="4,4,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Project Knowledge" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="AGENTS.md" Command="{Binding ShowMemoryTabCommand}" FontSize="11" Padding="10,4"/>
                    <Button Content="Skills" Command="{Binding ShowSkillsTabCommand}" FontSize="11" Padding="10,4"/>
                    <Button Content="Characters" Command="{Binding ShowCharactersTabCommand}" FontSize="11" Padding="10,4"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="24" Height="24" Padding="0" FontSize="11"
                        Command="{Binding CloseCommand}"/>
            </Grid>
        </Border>

        <!-- Sub-toolbar per tab -->
        <Border Grid.Row="1" Background="{DynamicResource AppSubBrush}" Padding="8,4">
            <Grid>
                <!-- Memory toolbar -->
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsMemoryTabActive}">
                    <Button Content="Create" Command="{Binding CreateMemoryFileCommand}"
                            IsVisible="{Binding !MemoryFileExists}" FontSize="11" Padding="8,3"/>
                    <Button Content="💾 Save" Command="{Binding SaveMemoryCommand}"
                            IsEnabled="{Binding MemoryIsDirty}" FontSize="11" Padding="8,3"/>
                    <Button Content="🩺 Doctor" Command="{Binding RunDoctorCommand}" FontSize="11" Padding="8,3"/>
                    <TextBlock Text="{Binding MemoryStatusText}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <!-- Skills toolbar -->
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsSkillsTabActive}">
                    <Button Content="🔄 Refresh" Command="{Binding RefreshSkillsCommand}" FontSize="11" Padding="8,3"/>
                    <Button Content="＋ New Skill" Command="{Binding BeginCreateSkillCommand}" FontSize="11" Padding="8,3"/>
                    <Button Content="💾 Save" Command="{Binding SaveSelectedSkillCommand}"
                            IsEnabled="{Binding SelectedSkillIsDirty}" FontSize="11" Padding="8,3"/>
                    <Button Content="✎ Rename" Command="{Binding BeginRenameSkillCommand}"
                            IsEnabled="{Binding HasSelectedSkill}" FontSize="11" Padding="8,3"/>
                    <Button Content="🗑 Delete" Command="{Binding RequestDeleteSkillCommand}"
                            IsEnabled="{Binding HasSelectedSkill}" FontSize="11" Padding="8,3"/>
                    <TextBlock Text="{Binding SkillsStatusText}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <!-- Characters toolbar -->
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsCharactersTabActive}">
                    <Button Content="🔄 Refresh" Command="{Binding Characters.RefreshCommand}" FontSize="11" Padding="8,3"/>
                    <Button Content="＋ New Character" Command="{Binding Characters.BeginCreateCommand}" FontSize="11" Padding="8,3"/>
                    <Button Content="💾 Save" Command="{Binding Characters.SaveCommand}"
                            IsEnabled="{Binding Characters.SelectedIsDirty}" FontSize="11" Padding="8,3"/>
                    <Button Content="🗑 Delete" Command="{Binding Characters.RequestDeleteCommand}"
                            IsEnabled="{Binding Characters.CanEditSelected}" FontSize="11" Padding="8,3"/>
                    <TextBlock Text="{Binding Characters.StatusText}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Memory tab body -->
        <Grid Grid.Row="2" RowDefinitions="*,Auto" IsVisible="{Binding IsMemoryTabActive}">
            <TextBox Grid.Row="0"
                     Text="{Binding MemoryContent}"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas,Menlo,monospace"
                     FontSize="12"
                     BorderThickness="0"
                     VerticalContentAlignment="Top"/>
            <Border Grid.Row="1" Background="{DynamicResource AppDeepBrush}" MaxHeight="160" Padding="8">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding DoctorChecks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="core:DoctorCheck">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                    <TextBlock Text="{Binding Status}" FontSize="10" Width="60"
                                               Foreground="#9AA0A6"/>
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Width="140"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Skills tab body -->
        <Grid Grid.Row="2" ColumnDefinitions="240,*" IsVisible="{Binding IsSkillsTabActive}">
            <!-- Skill list with search -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <TextBox Grid.Row="0" Text="{Binding SkillFilter}" Watermark="Search name, description or #tag"
                         FontSize="11" Margin="4"/>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Skills}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SkillListItem">
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        Padding="8,6"
                                        Command="{Binding DataContext.SelectSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding TagsLabel}" FontSize="9" Opacity="0.5"
                                                   IsVisible="{Binding TagsLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Text="{Binding ScopeLabel}" FontSize="9" Opacity="0.4"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Selected skill editor / new-skill form -->
            <Grid Grid.Column="1" Margin="8,0,0,0" RowDefinitions="Auto,Auto,*,Auto">
                <!-- Delete confirmation -->
                <Border Grid.Row="0" IsVisible="{Binding IsConfirmingSkillDelete}" Background="{DynamicResource AppSubBrush}"
                        CornerRadius="4" Padding="10" Margin="0,4">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding SkillDeleteConfirmText}" FontSize="11" TextWrapping="Wrap"/>
                        <CheckBox Content="Also remove it from those characters" IsChecked="{Binding RemoveSkillFromCharacters}" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Delete" Command="{Binding ConfirmDeleteSkillCommand}" FontSize="11" Padding="10,4"/>
                            <Button Content="Cancel" Command="{Binding CancelDeleteSkillCommand}" FontSize="11" Padding="10,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Rename -->
                <Border Grid.Row="1" IsVisible="{Binding IsRenamingSkill}" Background="{DynamicResource AppSubBrush}"
                        CornerRadius="4" Padding="10" Margin="0,4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="New name" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding RenameSkillName}" MinWidth="200" FontSize="11"/>
                        <Button Content="Rename" Command="{Binding ConfirmRenameSkillCommand}" FontSize="11" Padding="10,4"/>
                        <Button Content="Cancel" Command="{Binding CancelRenameSkillCommand}" FontSize="11" Padding="10,4"/>
                        <TextBlock Text="Characters using it are updated." FontSize="10" Opacity="0.6" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBox Grid.Row="2"
                         Text="{Binding SelectedSkillContent}"
                         IsVisible="{Binding !IsCreatingSkill}"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas,Menlo,monospace"
                         FontSize="12"
                         BorderThickness="0"
                         VerticalContentAlignment="Top"/>

                <Border Grid.Row="2" IsVisible="{Binding IsCreatingSkill}"
                        Background="{DynamicResource AppSubBrush}"
                        CornerRadius="6"
                        Padding="16"
                        MaxWidth="420"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <StackPanel Spacing="8">
                        <TextBlock Text="New Skill" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Name (kebab-case)" FontSize="10" Opacity="0.6"/>
                        <TextBox Text="{Binding NewSkillName}" Watermark="e.g. release-notes"/>
                        <TextBlock Text="Description (one line — shown to the model)" FontSize="10" Opacity="0.6"/>
                        <TextBox Text="{Binding NewSkillDescription}" Watermark="When should the agent use this skill?"/>
                        <CheckBox Content="Project skill (.aiagent/skills — unchecked = global, ~/.aiagent/skills)"
                                  IsChecked="{Binding NewSkillIsProject}" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding CancelCreateSkillCommand}" FontSize="11" Padding="10,4"/>
                            <Button Content="Create" Command="{Binding CreateSkillCommand}" FontSize="11" Padding="10,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Usage + validation -->
                <Border Grid.Row="3" Background="{DynamicResource AppDeepBrush}" Padding="8" MaxHeight="110"
                        IsVisible="{Binding SelectedSkillDetails, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <ScrollViewer>
                        <TextBlock Text="{Binding SelectedSkillDetails}" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Characters tab body -->
        <Grid Grid.Row="2" ColumnDefinitions="240,*,280" IsVisible="{Binding IsCharactersTabActive}">
            <!-- Character list -->
            <ScrollViewer Grid.Column="0">
                <ItemsControl ItemsSource="{Binding Characters.Characters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:CharacterListItem">
                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    Padding="8,6"
                                    Command="{Binding DataContext.Characters.SelectCharacterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ScopeLabel}" FontSize="9" Opacity="0.4"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Selected character: summary, editor, new-character form -->
            <Grid Grid.Column="1" Margin="8,0,0,0" RowDefinitions="Auto,Auto,*,Auto">
                <Border Grid.Row="0" IsVisible="{Binding Characters.IsConfirmingDelete}" Background="{DynamicResource AppSubBrush}"
                        CornerRadius="4" Padding="10" Margin="0,4">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Characters.DeleteConfirmText}" FontSize="11" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Delete" Command="{Binding Characters.ConfirmDeleteCommand}" FontSize="11" Padding="10,4"/>
                            <Button Content="Cancel" Command="{Binding Characters.CancelDeleteCommand}" FontSize="11" Padding="10,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="1" Text="{Binding Characters.SelectedSummary}" FontSize="11" Opacity="0.8"
                           TextWrapping="Wrap" Margin="0,4,0,6" IsVisible="{Binding !Characters.IsCreating}"/>

                <TextBox Grid.Row="2"
                         Text="{Binding Characters.SelectedContent}"
                         IsVisible="{Binding !Characters.IsCreating}"
                         IsReadOnly="{Binding Characters.SelectedIsBuiltIn}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontFamily="Consolas,Menlo,monospace"
                         FontSize="12"
                         BorderThickness="0"
                         VerticalContentAlignment="Top"/>

                <Border Grid.Row="2" IsVisible="{Binding Characters.IsCreating}"
                        Background="{DynamicResource AppSubBrush}"
                        CornerRadius="6" Padding="16" MaxWidth="440"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel Spacing="8">
                        <TextBlock Text="New Character" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Display name" FontSize="10" Opacity="0.6"/>
                        <TextBox Text="{Binding Characters.NewDisplayName}" Watermark="e.g. Alex — Architect"/>
                        <TextBlock Text="Id (kebab-case, file name)" FontSize="10" Opacity="0.6"/>
                        <TextBox Text="{Binding Characters.NewId}" Watermark="e.g. alex-architect"/>
                        <TextBlock Text="Avatar (emoji or initials, optional)" FontSize="10" Opacity="0.6"/>
                        <TextBox Text="{Binding Characters.NewAvatar}" Watermark="🧭"/>
                        <TextBlock Text="Description (what this character is for)" FontSize="10" Opacity="0.6"/>
                        <TextBox Text="{Binding Characters.NewDescription}" Watermark="Designs solutions and writes ADRs; never edits code"/>
                        <TextBlock Text="Base role (tools and permissions it starts from; empty = generic agent)" FontSize="10" Opacity="0.6"/>
                        <ComboBox ItemsSource="{Binding Characters.BaseRoles}" SelectedItem="{Binding Characters.NewBaseRole}" MinWidth="200"/>
                        <CheckBox Content="Project character (.aiagent/characters — unchecked = global, ~/.aiagent/characters)"
                                  IsChecked="{Binding Characters.NewIsProject}" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding Characters.CancelCreateCommand}" FontSize="11" Padding="10,4"/>
                            <Button Content="Create" Command="{Binding Characters.CreateCommand}" FontSize="11" Padding="10,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Background="{DynamicResource AppDeepBrush}" Padding="8" MaxHeight="110"
                        IsVisible="{Binding Characters.SelectedProblems, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <ScrollViewer>
                        <TextBlock Text="{Binding Characters.SelectedProblems}" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Skill checklist -->
            <Border Grid.Column="2" Background="{DynamicResource AppSubBrush}" Margin="8,0,0,0" Padding="8"
                    IsVisible="{Binding !Characters.IsCreating}">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <TextBlock Grid.Row="0" Text="Skills" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" FontSize="10" Opacity="0.6" TextWrapping="Wrap" Margin="0,2,0,4"
                               Text="Tick to give the character a skill (loaded on demand). Pin to keep its full instructions in context on every turn."/>
                    <StackPanel Grid.Row="2" Spacing="4">
                        <TextBlock FontSize="10" Foreground="#E0A040" TextWrapping="Wrap" IsVisible="{Binding Characters.SelectedUsesAllSkills}"
                                   Text="This character can use every skill. Ticking a skill restricts it to the ticked list."/>
                        <TextBox Text="{Binding Characters.SkillFilter}" Watermark="Filter skills" FontSize="11"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="3" Margin="0,6,0,0">
                        <ItemsControl ItemsSource="{Binding Characters.SkillChoices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:CharacterSkillChoice">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsAssigned}" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Hint}" FontSize="9" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="2" Content="📌" IsChecked="{Binding IsPinned}"
                                                      ToolTip.Tip="Pin: always in context" Padding="4,0" FontSize="10"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
