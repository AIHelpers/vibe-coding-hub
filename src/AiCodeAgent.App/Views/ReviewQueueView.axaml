<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AiCodeAgent.App.ViewModels"
             xmlns:views="using:AiCodeAgent.App.Views"
             xmlns:ctl="using:AiCodeAgent.App.Controls"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:mdtight="https://github.com/whistyun/Markdown.Avalonia.Tight"
             x:Class="AiCodeAgent.App.Views.ReviewQueueView"
             x:DataType="vm:ReviewQueueViewModel"
             x:CompileBindings="True">
    <!-- E10-S3: everything waiting for a human in one list. J/K move, A approves, R sends a comment back, X declines. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
        <Border Grid.Row="0" Background="{DynamicResource AppHeaderBrush}" Padding="10" CornerRadius="4,4,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Review" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SummaryText}" FontSize="11"
                               Foreground="{DynamicResource ThemeTextMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="24" Height="24" Padding="0" FontSize="11"
                        Command="{Binding CloseCommand}" ToolTip.Tip="Close"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Margin="10,6" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource ThemeTextMutedBrush}"
                   Text="J / K move · A approve · R request changes · X decline"/>

        <ListBox Grid.Row="2" Name="ReviewList" MaxHeight="200" Margin="6,0"
                 ItemsSource="{Binding Queue.Items}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 IsVisible="{Binding HasItems}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ReviewItem">
                    <StackPanel Spacing="2" Margin="2,3">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Background="{DynamicResource AppBadgeBrush}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="250" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                   Foreground="{DynamicResource ThemeTextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- The item in front of the reviewer -->
        <Grid Grid.Row="3" Margin="10,8,10,0">
            <TextBlock Text="Nothing is waiting for you." IsVisible="{Binding IsEmpty}"
                       Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="12"/>
            <ScrollViewer IsVisible="{Binding HasSelection}" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding SelectedItem.Title}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedItem.Subtitle}" FontSize="11"
                               Foreground="{DynamicResource ThemeTextMutedBrush}" TextWrapping="Wrap"/>

                    <views:DiffPreviewView DataContext="{Binding SelectedItem.Preview}"
                                           IsVisible="{Binding IsFileDiff, FallbackValue=False}"/>
                    <Border IsVisible="{Binding SelectedItem.Preview.IsCommand, FallbackValue=False}"
                            Background="{DynamicResource AppDeepBrush}" CornerRadius="4" Padding="10">
                        <SelectableTextBlock Text="{Binding SelectedItem.Preview.CommandText, FallbackValue=''}"
                                             FontFamily="Consolas,Menlo,monospace" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <md:MarkdownScrollViewer ctl:MarkdownWrap.WrapText="True" Markdown="{Binding SelectedItem.Detail}">
                        <md:MarkdownScrollViewer.Styles>
                            <StyleInclude Source="../Styles/MarkdownTheme.axaml"/>
                        </md:MarkdownScrollViewer.Styles>
                        <md:MarkdownScrollViewer.Plugins>
                            <md:MdAvPlugins>
                                <mdtight:ChatAISetup/>
                            </md:MdAvPlugins>
                        </md:MarkdownScrollViewer.Plugins>
                    </md:MarkdownScrollViewer>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Request changes: the comment goes back to the agent -->
        <Border Grid.Row="4" Margin="10,6,10,0" Padding="8" CornerRadius="6" IsVisible="{Binding IsEnteringComment}"
                Background="{DynamicResource AppInsetBrush}">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding SelectedItem.ChangesHint}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                <TextBox Name="CommentBox" Text="{Binding Comment, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="64" MaxHeight="140" Watermark="What should change?"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Send (Ctrl+Enter)" Command="{Binding SubmitCommentCommand}" Padding="8,3" FontSize="11"/>
                    <Button Content="Cancel (Esc)" Command="{Binding CancelCommentCommand}" Padding="8,3" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="5" Margin="10,8,10,10" Spacing="6" IsVisible="{Binding HasSelection}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="{Binding SelectedItem.ApproveLabel, StringFormat='{}{0} (A)'}"
                        Command="{Binding ApproveSelectedCommand}" Padding="10,4" FontSize="12"/>
                <Button Content="{Binding SelectedItem.ChangesLabel, StringFormat='{}{0} (R)'}"
                        Command="{Binding BeginRequestChangesCommand}" IsVisible="{Binding CanRequestChanges}"
                        Padding="10,4" FontSize="12"/>
                <Button Content="{Binding SelectedItem.DeclineLabel, StringFormat='{}{0} (X)'}"
                        Command="{Binding DeclineSelectedCommand}" IsVisible="{Binding CanDecline}"
                        Padding="10,4" FontSize="12"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource ThemeTextMutedBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
